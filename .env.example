# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Include prompts and responses in the SDK spans (default: metadata_only).
ANTHROPIC_OPEN_TELEMETRY_TRACES_CONTENT_MODE=content
# LAB_MODEL=claude-opus-5-5
# LAB_SESSION_BUDGET_CENTS=50

# --- Where to send telemetry: pick ONE ---

# Option A: Bronto (the lab fills in the OTLP settings for you)
BRONTO_API_KEY=
BRONTO_REGION=eu

# Option B: any OTLP/HTTP backend, standard OpenTelemetry variables
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>

# Option C: nothing set -> spans are printed to the console
